<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent that refreshes the TryHackMe badges daily from this (residential)
  Mac. Install: copy to ~/Library/LaunchAgents/, then `launchctl load -w` it.

  It runs the script from a clone under ~/.cache (NOT ~/Documents): launchd is
  denied access to ~/Documents / ~/Desktop / ~/Downloads by macOS TCC, so the
  engine lives in ~/.cache/thm-badge/Tryhackme-Badge instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.keizersec.thm-badge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/keizer/.cache/thm-badge/Tryhackme-Badge/scripts/refresh-badges.sh</string>
    </array>

    <!-- Twice daily (13:00 and 19:00 local) as a safety net: if the first run
         fires just after wake before the network is up, the second one catches it.
         If the Mac is asleep/off at both times, launchd runs it at the next wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>13</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>19</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- Also run shortly after load/login, so a missed day self-heals on next boot. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/keizer/Library/Logs/thm-badge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/keizer/Library/Logs/thm-badge.log</string>
</dict>
</plist>
